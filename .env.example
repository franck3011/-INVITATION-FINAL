# ==========================================
# VARIABLES D'ENVIRONNEMENT POUR VERCEL
# ==========================================

# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://cdznzknmshpjjigubyum.supabase.co
SUPABASE_URL=https://cdznzknmshpjjigubyum.supabase.co

# Clé publique (anon / publishable)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clé secrète Service Role (Admin - Ne jamais exposer côté client)
SB_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...
# ou
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...

# Token Super Admin (accès à /super/$token pour gérer tous les événements)
SUPER_ADMIN_TOKEN=votre_super_admin_secret_token

# (Optionnel) Clé secrète Cloudflare Turnstile pour l'anti-bot CAPTCHA
TURNSTILE_SECRET_KEY=

# Autorisation déploiement Vercel (Requis par Vercel pour les versions TanStack Start actuelles)
DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS=1

